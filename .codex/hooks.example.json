{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/prompt-review.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/prompt-review.mjs\"",
            "timeout": 5,
            "statusMessage": "Reviewing prompt",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/prompt-review.mjs\"",
            "timeout": 5,
            "statusMessage": "Starting refined task"
          }
        ]
      }
    ]
  }
}
